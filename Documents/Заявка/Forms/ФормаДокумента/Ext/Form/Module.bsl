#Область ОбработчикиСобытийФормы

// Обработчик открытия формы
//
// Параметры:
//   Отказ - Булево - Признак отмены открытия формы
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
КонецПроцедуры

// Устанавливает текущий статус заявки при открытии формы
//
&НаСервере
Процедура ПриОткрытииНаСервере()
	Если НЕ Объект.Проведен Тогда 
		Объект.СтатусЗаявки = ТекущийСтатусЗаявки(Объект.Ссылка);
	Иначе
		Объект.СтатусЗаявки = Перечисления.СтатусыЗаявки.Закрыта;	
	КонецЕсли;
КонецПроцедуры

// Настраивает доступность элементов формы после чтения объекта
//
// Параметры:
//   ТекущийОбъект - ДокументОбъект.Заявка - Прочитанный объект документа
//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Если ТекущийОбъект.Проведен Тогда
		Элементы.Услуги.ТолькоПросмотр 			= Истина;
		Элементы.Клиент.ТолькоПросмотр 			= Истина;
		Элементы.СтатусЗаявки.ТолькоПросмотр 	= Истина; 
		Элементы.Клиент.КнопкаОткрытия 			= Ложь;
	Иначе
		Элементы.Услуги.ТолькоПросмотр 			= Ложь;
		Элементы.Клиент.ТолькоПросмотр 			= Ложь;
		Элементы.СтатусЗаявки.ТолькоПросмотр 	= Ложь; 
		Элементы.Клиент.КнопкаОткрытия 			= Истина;
	КонецЕсли;
КонецПроцедуры 

// Записывает статус заявки в регистр сведений после записи документа
//
// Параметры:
//   ТекущийОбъект - ДокументОбъект.Заявка - Записанный объект документа
//   ПараметрыЗаписи - Структура - Параметры записи документа
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.СтатусЗаявки <> Перечисления.СтатусыЗаявки.ПустаяСсылка() Тогда 
		МенеджерЗаписи = РегистрыСведений.СтатусыЗаявок.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Заявка = Объект.Ссылка;
		МенеджерЗаписи.Период = ТекущаяДатаСеанса();
		МенеджерЗаписи.Статус = Объект.СтатусЗаявки;
	Иначе
		МенеджерЗаписи = РегистрыСведений.СтатусыЗаявок.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Заявка = Объект.Ссылка;
		МенеджерЗаписи.Период = ТекущаяДатаСеанса();
		МенеджерЗаписи.Статус = Перечисления.СтатусыЗаявки.Новая;
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТабЧастиУслуги

// Обработчик изменения количества услуги в табличной части
//
// Параметры:
//   Элемент - ЭлементУправления - Элемент управления, вызвавший событие
//
&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	
	ТекущаяСрока = Элементы.Услуги.ТекущиеДанные;
	
	РассчитатьСуммуУслуги(ТекущаяСрока);
	
КонецПроцедуры

// Обработчик изменения цены услуги в табличной части
//
// Параметры:
//   Элемент - ЭлементУправления - Элемент управления, вызвавший событие
//
&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	
	ТекущаяСрока = Элементы.Услуги.ТекущиеДанные;
	
	РассчитатьСуммуУслуги(ТекущаяСрока);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИфункции

// Рассчитывает сумму услуги по количеству и цене
//
// Параметры:
//   ТекущаяСтрока - ДанныеФормыЭлементКоллекции - Строка табличной части Услуги
//
&НаКлиенте
Процедура РассчитатьСуммуУслуги(ТекущаяСтрока)
	
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	
КонецПроцедуры

// Возвращает текущий статус заявки из регистра сведений
//
// Параметры:
//   Заявка - ДокументСсылка.Заявка - Ссылка на документ заявка
//
// Возвращаемое значение:
//   ПеречислениеСсылка.СтатусыЗаявки - Текущий статус заявки
//
&НаСервереБезКонтекста
Функция ТекущийСтатусЗаявки(Заявка) 
	
	Статус = Перечисления.СтатусыЗаявки.Новая;
	
	Если Заявка <> Документы.Заявка.ПустаяСсылка() Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СтатусыЗаявокСрезПоследних.Статус КАК Статус
			|ИЗ
			|	РегистрСведений.СтатусыЗаявок.СрезПоследних(, Заявка = &Заявка) КАК СтатусыЗаявокСрезПоследних";
		
		Запрос.УстановитьПараметр("Заявка", Заявка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Статус = Выборка.Статус;	
		КонецЕсли;
		
    КонецЕсли;
		
    Возврат Статус;
	
КонецФункции // ()

#КонецОбласти 