# Область ОбработчикиСобытийФормы

// Обрабатывает начало выбора файла с сотрудниками
//
// Параметры:
//   Элемент - ЭлементУправления - элемент управления
//   ДанныеВыбора - ДанныеВыбора - данные выбора
//   ВыборДобавлением - Булево - признак выбора с добавлением
//   СтандартнаяОбработка - Булево - признак стандартной обработки
&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(Объект.ФорматФайла) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выберите формат файла!";
		Сообщение.Поле = "Объект.ФорматФайла";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Проводник = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Проводник.Заголовок = "Выберите файл с сотрудниками";
                                   
	Если Объект.ФорматФайла = "CSV" Тогда
		Фильтр = "Текстовый документ (*.csv)|*.csv";
	ИначеЕсли Объект.ФорматФайла = "XLS" Тогда
		Фильтр = "Файл Exel (*.xlsx)|*.xlsx";
	Иначе
		Возврат;
	КонецЕсли;

	Проводник.Фильтр = Фильтр;

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
	Проводник.Показать(Оповещение);

КонецПроцедуры

// Обрабатывает результат выбора файла
//
// Параметры:
//   ВыбранныеФайлы - Массив - массив выбранных путей к файлам
//   ДополнительныеПараметры - Произвольный - дополнительные параметры
&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.ПутьКФайлу = ВыбранныеФайлы[0];

КонецПроцедуры

# КонецОбласти

# Область ЗагрузкаДанных

// Основная процедура чтения файла с сотрудниками
// Выбирает нужный метод чтения в зависимости от формата файла
//
// Параметры:
//   Команда - КомандаФормы - команда, вызвавшая процедуру
&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(Объект.ПутьКФайлу) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выберите файл!";
		Сообщение.Поле = "Объект.ПутьКФайлу";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Объект.СписокСотрудников.Очистить();

	Если Объект.ФорматФайла = "CSV" Тогда
		ПрочитатьФайл_CSV();
	ИначеЕсли Объект.ФорматФайла = "XLS" Тогда
		ПрочитатьФайл_XLSНаСервере();
	КонецЕсли;

КонецПроцедуры

// Читает данные из файла CSV и загружает в таблицу сотрудников
// Формат файла: Сотрудник;Отдел;Статус
&НаКлиенте
Процедура ПрочитатьФайл_CSV()

	Текст = Новый ЧтениеТекста(Объект.ПутьКФайлу, КодировкаТекста.Системная);
	
    Строка = Текст.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Данные = СтрРазделить(Строка, ";", Ложь);

		Если Данные.Количество() >= 3 Тогда // оставим на совесть заполнителя файла
			НоваяСтрока = Объект.СписокСотрудников.Добавить();
			НоваяСтрока.Сотрудник = СокрЛП(Данные[0]);
			НоваяСтрока.Отдел = СокрЛП(Данные[1]);
			НоваяСтрока.СтатусСотрудника = СокрЛП(Данные[2]);
		КонецЕсли;
		Строка = Текст.ПрочитатьСтроку();
	КонецЦикла;

КонецПроцедуры

// Читает данные из файла XLS на сервере и загружает в таблицу сотрудников
// Столбцы: 1 - Сотрудник, 2 - Отдел, 3 - Статус
&НаСервере
Процедура ПрочитатьФайл_XLSНаСервере()

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(Объект.ПутьКФайлу, СпособЧтенияЗначенийТабличногоДокумента.Значение);

	Для НомерСтроки = 1 По ТабличныйДокумент.ВысотаТаблицы Цикл

		ЗначениеСотрудник = ТабличныйДокумент.Область(НомерСтроки, 1).Текст;
		ЗначениеОтдел = ТабличныйДокумент.Область(НомерСтроки, 2).Текст;
		ЗначениеСтатус = ТабличныйДокумент.Область(НомерСтроки, 3).Текст;

		ЗначениеСотрудник = СокрЛП(ЗначениеСотрудник);
		ЗначениеОтдел = СокрЛП(ЗначениеОтдел);
		ЗначениеСтатус = СокрЛП(ЗначениеСтатус);

		Если Не ПустаяСтрока(ЗначениеСотрудник) Тогда
			НоваяСтрока = Объект.СписокСотрудников.Добавить();
			НоваяСтрока.Сотрудник = ЗначениеСотрудник;
			НоваяСтрока.Отдел = ЗначениеОтдел;
			НоваяСтрока.СтатусСотрудника = ЗначениеСтатус;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

# КонецОбласти

