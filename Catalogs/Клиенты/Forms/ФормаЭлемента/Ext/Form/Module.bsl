#Область ОбработчикиСобытийФормы

&НаКлиенте
// Проверяет наличие дубля клиента перед записью.
// Если клиент с такими Наименованием и ИНН уже существует, блокирует запись.
//
// Параметры:
//   Отказ - Булево - При установке в Истина запись будет отменена
//   ПараметрыЗаписи - Структура - Параметры операции записи
//
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПроверитьДублиКлиента(Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
// Проверяет наличие дубля клиента и показывает предупреждение.
// Вызывает серверную функцию для проверки и при нахождении дубля
// показывает сообщение пользователю и отменяет запись.
//
// Параметры:
//   Отказ - Булево - При установке в Истина запись будет отменена
//   ПараметрыЗаписи - Структура - Параметры операции записи
//
Процедура ПроверитьДублиКлиента(Отказ, ПараметрыЗаписи)
	
	Если ЕстьДублиКлиентаНаСервере(Объект.Наименование, Объект.ИНН) Тогда
		ПоказатьПредупреждение(, "Клиент с такими Наименованием и ИНН уже существует!");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
// Проверяет наличие клиента с заданными Наименованием и ИНН в базе данных.
// Выполняет запрос к справочнику Клиенты и возвращает признак наличия дубля.
//
// Параметры:
//   Наименование - Строка - Наименование клиента для проверки
//   ИНН - Строка - ИНН клиента для проверки
//
// Возвращаемое значение:
//   Булево - Истина если дубли найдены, Ложь если нет
//
Функция ЕстьДублиКлиентаНаСервере(ЗНАЧ Наименование, ЗНАЧ ИНН)
	
	ЕстьДубли = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Клиенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Клиенты КАК Клиенты
	|ГДЕ
	|	Клиенты.Наименование = &Наименование
	|	И Клиенты.ИНН = &ИНН";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда 
		ЕстьДубли = Истина;	
	КонецЕсли;
	
	Возврат ЕстьДубли;
		
КонецФункции

#КонецОбласти
